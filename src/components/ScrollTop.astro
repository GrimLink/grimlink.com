---
import { ArrowUp } from "@lucide/astro";
---

<a href="#top" class="btn scroll-top" aria-label="Back to top">
	<ArrowUp size={20} aria-hidden="true" />
</a>

<style>
	.scroll-top {
		--btn-px: var(--size-3);
		--btn-py: var(--size-3);
		--btn-radius: 99px;
		--btn-bg: var(--root-bg);
		--btn-stroke: oklch(from var(--root-fg) l c h / 20%);
		z-index: 5;
		position: fixed;
		inset: auto var(--size-4) var(--size-4) auto;
		transition:
			opacity 0.3s,
			visibility 0.3s;

		@container (not scroll-state(scrollable: top)) {
			opacity: 0;
			visibility: hidden;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		:global(html) {
			scroll-behavior: smooth;
		}
	}
</style>
